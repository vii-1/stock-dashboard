# SQLite file used by Prisma
DATABASE_URL="file:./dev.db"

# Sign up free at https://ipoalerts.in (India IPOs)
IPOALERTS_API_KEY=

# Sign up free at https://finnhub.io (US IPO calendar)
FINNHUB_API_KEY=

# Optional: CoinGecko free key raises rate limits (not required for v1)
COINGECKO_API_KEY=

# Sign up at https://developers.kite.trade (Zerodha Kite Connect) -
# create a "Connect" app with redirect URL http://localhost:3000/api/kite/callback
# Access tokens expire every trading day - see /kite in the nav to re-login.
KITE_API_KEY=
KITE_API_SECRET=

# Angel One SmartAPI (read-only holdings) - create an app at
# https://smartapi.angelone.in (type "Trading APIs") and paste its API key.
# Also enable TOTP for SmartAPI; you log in daily at /angel with client ID,
# MPIN and the 6-digit code. MPIN/TOTP are never stored.
ANGEL_API_KEY=
